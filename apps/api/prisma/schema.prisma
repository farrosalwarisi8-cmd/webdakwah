// Skema database WebDakwah (Postgres / Supabase).
// URL koneksi diatur di prisma.config.ts, bukan di file ini (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CONTRIBUTOR
}

/// Profil aplikasi, terhubung 1:1 ke auth.users milik Supabase (id sama).
/// Role sengaja disimpan di sini, bukan di metadata auth, agar pengguna tidak
/// bisa menaikkan hak aksesnya sendiri.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique @db.VarChar(254)
  fullName  String?  @map("full_name") @db.VarChar(120)
  role      Role     @default(CONTRIBUTOR)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  contents      Content[]
  uploads       UploadRequestLog[]
  notifications Notification[]
  watchings BroadcastWatching[]

  @@map("profiles")
}

enum ContentType {
  ARTICLE
  AUDIO
  VIDEO
  LINK
}

/// DRAFT -> PENDING_REVIEW -> PUBLISHED, dengan cabang REJECTED -> DRAFT
/// dan PUBLISHED -> ARCHIVED. Transisi ditegakkan di ContentsService.
enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Content {
  id          String        @id @default(uuid()) @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  type        ContentType
  status      ContentStatus @default(DRAFT)
  title       String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(220)
  excerpt     String?       @db.VarChar(300)
  body        String?       @db.Text
  transcript  String?       @db.Text
  mediaUrl    String?       @map("media_url") @db.VarChar(2048)
  reviewNote  String?       @map("review_note") @db.VarChar(500)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  speakerId   String?       @map("speaker_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  author      Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  speaker     Speaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  categories    ContentCategory[]
  tags          ContentTag[]
  links         ContentLink[]
  notifications Notification[]

  @@index([authorId, updatedAt])
  @@index([status, publishedAt])
  @@index([speakerId])
  @@map("contents")
}

/// Catatan presign unggahan untuk kuota per pengguna. Disimpan di database
/// agar tidak hilang saat Render memulai ulang instance.
model UploadRequestLog {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([createdAt])
  @@map("upload_requests")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(60)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  contents ContentCategory[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(30)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  contents ContentTag[]

  @@map("tags")
}

model Speaker {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  bio       String?  @db.VarChar(500)
  avatarUrl String?  @map("avatar_url") @db.VarChar(2048)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  contents  Content[]
  schedules BroadcastSchedule[]

  @@map("speakers")
}

model ContentCategory {
  contentId  String @map("content_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  content  Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contentId, categoryId])
  @@index([categoryId])
  @@map("content_categories")
}

model ContentTag {
  contentId String @map("content_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@index([tagId])
  @@map("content_tags")
}

enum PlayMode {
  EMBED
  EXTERNAL
}

/// Pengaturan siaran langsung radio mitra. Hanya berisi alamat dengar publik;
/// kredensial panel radio tidak pernah disimpan di database.
model LiveStream {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @default("Siaran Langsung") @db.VarChar(120)
  description String?  @db.VarChar(500)
  streamUrl   String?  @map("stream_url") @db.VarChar(2048)
  playMode    PlayMode @default(EXTERNAL) @map("play_mode")
  statusUrl   String?  @map("status_url") @db.VarChar(2048)
  telegramUrl String?  @map("telegram_url") @db.VarChar(2048)
  isEnabled   Boolean  @default(false) @map("is_enabled")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  watchings   BroadcastWatching[]

  @@map("live_stream")
}

/// Jadwal siaran: mingguan (dayOfWeek) ATAU acara khusus (date), salah satu
/// wajib. Jam selalu dalam WIB (Asia/Jakarta).
model BroadcastSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(120)
  speakerId   String?  @map("speaker_id") @db.Uuid
  dayOfWeek   Int?     @map("day_of_week") @db.SmallInt
  date        DateTime? @db.Date
  startTime   String   @map("start_time") @db.VarChar(5)
  durationMin Int      @default(60) @map("duration_min")
  notes       String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  speaker Speaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@index([dayOfWeek, startTime])
  @@index([date])
  @@map("broadcast_schedules")
}

enum NotificationType {
  CONTENT_SUBMITTED
  CONTENT_PUBLISHED
  CONTENT_REJECTED
}

/// Pemberitahuan untuk satu penerima. `title` dan `message` disalin saat
/// dibuat agar riwayat tetap terbaca walau konten diubah; `href` hanya berisi
/// rute dashboard internal yang dibuat server.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String?          @db.VarChar(500)
  href      String?          @db.VarChar(300)
  contentId String?          @map("content_id") @db.Uuid
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([contentId])
  @@map("notifications")
}

/// Pengikut siaran langsung: satu baris unik per (profil, channel). Dipakai
/// untuk menghitung pengikut publik dan menampilkan daftarnya ke admin;
/// data pengguna tidak pernah dikirim ke publik.
model BroadcastWatching {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  channel LiveStream @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([profileId, channelId])
  @@index([profileId])
  @@index([channelId])
  @@map("broadcast_watchings")
}

model ContentLink {
  id        String   @id @default(uuid()) @db.Uuid
  contentId String   @map("content_id") @db.Uuid
  title     String   @db.VarChar(200)
  url       String   @db.VarChar(2048)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, order])
  @@map("content_links")
}
