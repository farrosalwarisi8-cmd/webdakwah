# Salin ke .env lalu isi nilainya. Jangan pernah commit .env.

# --- Wajib (Fase 1) ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Beberapa origin dipisah koma, tanpa spasi.
FRONTEND_ORIGINS=http://localhost:3000

# --- Fase 2: database & auth (Supabase) ---
# Gunakan connection pooler (port 6543) untuk aplikasi.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- Fase 4: Cloudflare R2 (upload media) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=

# --- Fase 7: revalidasi cache frontend ---
# FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_SECRET=
