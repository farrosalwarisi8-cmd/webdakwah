# Salin ke .env lalu isi nilainya. Jangan pernah commit .env.

# --- Wajib (Fase 1) ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Beberapa origin dipisah koma, tanpa spasi.
FRONTEND_ORIGINS=http://localhost:3000

# --- Fase 2: database & auth (Supabase) ---
# DATABASE_URL memakai connection pooler (port 6543) untuk aplikasi.
# DIRECT_URL (port 5432) dipakai Prisma CLI untuk migrasi.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# Opsional: pakai bila JWKS berada di domain kustom.
# SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Opsional: hanya untuk proyek Supabase lama yang masih menandatangani token dengan HS256.
# SUPABASE_JWT_SECRET=

# --- Hanya untuk `pnpm --filter api db:seed` (jangan dipakai rutin) ---
# SUPABASE_SERVICE_ROLE_KEY=
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=minimal-8-karakter

# --- Fase 9: Cloudflare R2 (unggah media) ---
# Isi kelimanya agar POST /api/uploads/presign aktif; tanpa itu endpoint 503.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# URL publik bucket/domain kustom, tanpa garis miring di akhir.
# R2_PUBLIC_BASE_URL=https://media.contoh.com
# Opsional: endpoint S3 kustom untuk uji lokal (MinIO), bukan untuk produksi.
# R2_ENDPOINT=http://127.0.0.1:9000

# --- Fase 10: batas laju & kuota unggah ---
# Semua opsional; nilai di bawah adalah default. Endpoint terautentikasi dihitung
# per pengguna, endpoint publik per IP. Angka dalam permintaan per menit.
# THROTTLE_GLOBAL_PER_MIN=600
# THROTTLE_UPLOAD_PER_MIN=10
# THROTTLE_SEARCH_PER_MIN=600
# THROTTLE_SESSION_PER_MIN=60
# Fase 19: GET /api/public/live per IP.
# THROTTLE_LIVE_PER_MIN=120
# Kuota presign per pengguna. Admin bebas kuota harian.
# UPLOAD_QUOTA_PER_HOUR=20
# UPLOAD_QUOTA_PER_DAY=60
# UPLOAD_QUOTA_ADMIN_PER_HOUR=100

# --- Fase 7: revalidasi cache frontend (opsional) ---
# Isi keduanya agar konten terbit/arsip langsung tampil di web.
# FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_SECRET=minimal-16-karakter
